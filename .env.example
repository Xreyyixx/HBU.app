# --- Firebase (публичный конфиг проекта) ---
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# --- Служебный аккаунт сервера в Firebase Auth ---
# Отдельный пользователь, для которого создан документ admins/{uid}.
# Нужен серверу для чтения push-подписок и очереди рассылок.
FIREBASE_SERVER_EMAIL=
FIREBASE_SERVER_PASSWORD=

# --- Мастер-ключ для отзыва сессий администраторов (длинная случайная строка) ---
ADMIN_MASTER_KEY=

# --- Web Push (сгенерировать: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Если сервер работает за прокси (Cloud Run, nginx) — 1
TRUST_PROXY=
